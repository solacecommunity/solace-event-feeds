{
  "asyncapi": "2.5.0",
  "info": {
    "title": "Trip Disruption Ops Hub",
    "version": "1.0.0",
    "description": "Operational event stream that disrupts trips already planned by the\nSolace Agent Mesh Multi-Agent Travel Planning workshop.\n\nPublishes four classes of real-world event (flight irregularities, weather\nalerts, hotel property impacts, ground advisories) and consumes the decision\nevent that Solace Agent Mesh emits after it repairs an itinerary.\n\nDESIGN CONSTRAINTS FOR STM FEED GENERATION\n------------------------------------------\n1. Every topic parameter and payload field is generated INDEPENDENTLY by\n   Faker. Correlated values (country+city, airline+flight number) are\n   therefore folded into a single composite level rather than split across\n   two levels, so they can never drift apart.\n2. Events carry IDENTIFIERS plus WHAT CHANGED. They deliberately do NOT\n   carry reference data (airline name, city name, aircraft type, star\n   rating, room descriptions). The SAM agents enrich from the `amadeus`\n   PostgreSQL database, which is the system of record. This removes almost\n   all cross-field consistency risk.\n3. No event carries both a start timestamp and an end timestamp. End times\n   are expressed as durations, which are always internally consistent.\n4. All free text is drawn from curated enums, never from Faker lorem.\n\nTOPIC SHAPE\n-----------\n  travel/<object>/<verb>/<version>/<severity>/<where>/<specifics...>\n\n`severity` is always level 5 and `where` is always level 6 across every\nevent type, so cross-domain subscriptions work without payload knowledge:\n\n  travel/>                            all events\n  travel/*/*/v1/critical/>            all critical events, any domain\n  travel/*/*/v1/*/JP-*/>              everything happening in Japan\n  travel/flight/status-changed/v1/*/*/*/SQ*/>   one airline's disruptions\n",
    "contact": {
      "name": "Solace Developer Advocacy",
      "url": "https://solace.dev/"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    }
  },
  "defaultContentType": "application/json",
  "servers": {
    "solace-broker": {
      "url": "tcp://localhost:55555",
      "protocol": "smf",
      "description": "Local or Solace Cloud PubSub+ broker. Overridden at `stm feed run` time."
    }
  },
  "channels": {
    "travel/flight/status-changed/v1/{severity}/{corridorKey}/{disruptionType}": {
      "description": "An airline operational irregularity affecting a scheduled flight: delay, cancellation, gate change, diversion or equipment swap.\n",
      "parameters": {
        "severity": {
          "description": "Business impact of the event. Fixed at level 5 across all event types.",
          "schema": {
            "type": "string",
            "enum": [
              "info",
              "minor",
              "major",
              "critical"
            ]
          }
        },
        "corridorKey": {
          "description": "Origin country, origin airport and destination airport as ONE token. Origin and destination are never generated independently, so an unroutable pair cannot occur. The five values are exactly the routes exercised by the workshop's own test prompts. Subscribe with `SG-*` for Singapore departures, `SG-SIN-HND` for one route.\n",
          "schema": {
            "type": "string",
            "enum": [
              "SG-SIN-HND",
              "SG-SIN-NRT",
              "IN-BLR-SFO",
              "KE-NBO-EZE",
              "GB-LHR-DPS"
            ]
          }
        },
        "disruptionType": {
          "description": "Replaces the former {flightKey} level. Far more useful to subscribe on — an agent that only cares about cancellations can say so in the subscription rather than in a prompt.\n",
          "schema": {
            "type": "string",
            "enum": [
              "delay",
              "cancellation",
              "gate-change",
              "diversion",
              "equipment-change",
              "schedule-change"
            ]
          }
        }
      },
      "subscribe": {
        "operationId": "publishFlightStatusChanged",
        "summary": "Flight irregularity published by airline operations.",
        "message": {
          "$ref": "#/components/messages/FlightStatusChanged"
        }
      }
    },
    "travel/weather/alert-issued/v1/{severity}/{locationKey}/{alertType}": {
      "description": "A meteorological alert issued for a destination, threatening outdoor activities, packing assumptions or ground transport.\n",
      "parameters": {
        "severity": {
          "schema": {
            "type": "string",
            "enum": [
              "info",
              "minor",
              "major",
              "critical"
            ]
          }
        },
        "locationKey": {
          "description": "ISO country code and destination CITY code, joined by a hyphen. Note these are city codes (TYO, LON, BUE), not airport codes — they match hotel_offers.city_code.\n",
          "schema": {
            "type": "string",
            "enum": [
              "JP-TYO",
              "TH-HKT",
              "ID-DPS",
              "AR-BUE"
            ]
          }
        },
        "alertType": {
          "schema": {
            "type": "string",
            "enum": [
              "typhoon",
              "heavy-rain",
              "snow",
              "heatwave",
              "wind",
              "thunderstorm",
              "flood"
            ]
          }
        }
      },
      "subscribe": {
        "operationId": "publishWeatherAlertIssued",
        "summary": "Weather alert published by a national meteorological service.",
        "message": {
          "$ref": "#/components/messages/WeatherAlertIssued"
        }
      }
    },
    "travel/hotel/booking-impacted/v1/{severity}/{locationKey}/{impactType}": {
      "description": "A property-side event affecting an existing or prospective hotel stay: overbooking, closure, rate change, amenity outage or evacuation.\n",
      "parameters": {
        "severity": {
          "schema": {
            "type": "string",
            "enum": [
              "info",
              "minor",
              "major",
              "critical"
            ]
          }
        },
        "locationKey": {
          "schema": {
            "type": "string",
            "enum": [
              "JP-TYO",
              "TH-HKT",
              "ID-DPS",
              "AR-BUE"
            ]
          }
        },
        "impactType": {
          "schema": {
            "type": "string",
            "enum": [
              "overbooking",
              "maintenance-closure",
              "rate-change",
              "amenity-unavailable",
              "evacuation"
            ]
          }
        }
      },
      "subscribe": {
        "operationId": "publishHotelBookingImpacted",
        "summary": "Property impact published by a hotel PMS.",
        "message": {
          "$ref": "#/components/messages/HotelBookingImpacted"
        }
      }
    },
    "travel/ground/advisory-published/v1/{severity}/{locationKey}/{advisoryType}": {
      "description": "A destination-side advisory affecting local movement or activities: transit strike, road closure, attraction closure, major public event.\n",
      "parameters": {
        "severity": {
          "schema": {
            "type": "string",
            "enum": [
              "info",
              "minor",
              "major",
              "critical"
            ]
          }
        },
        "locationKey": {
          "schema": {
            "type": "string",
            "enum": [
              "JP-TYO",
              "TH-HKT",
              "ID-DPS",
              "AR-BUE"
            ]
          }
        },
        "advisoryType": {
          "schema": {
            "type": "string",
            "enum": [
              "transit-strike",
              "road-closure",
              "attraction-closure",
              "public-event",
              "security-alert",
              "health-notice"
            ]
          }
        }
      },
      "subscribe": {
        "operationId": "publishGroundAdvisoryPublished",
        "summary": "Local advisory published by a city transport or tourism authority.",
        "message": {
          "$ref": "#/components/messages/GroundAdvisoryPublished"
        }
      }
    },
    "travel/itinerary/replanned/v1/{severity}/{locationKey}/{tripId}/{outcome}": {
      "description": "Emitted by the TripGuardianAgent after Solace Agent Mesh has evaluated a disruption event and either repaired the itinerary, proposed options, escalated to a human, or decided no action was needed.\n",
      "parameters": {
        "severity": {
          "schema": {
            "type": "string",
            "enum": [
              "info",
              "minor",
              "major",
              "critical"
            ]
          }
        },
        "locationKey": {
          "schema": {
            "type": "string",
            "enum": [
              "JP-TYO",
              "TH-HKT",
              "ID-DPS",
              "AR-BUE"
            ]
          }
        },
        "tripId": {
          "schema": {
            "type": "string",
            "pattern": "^TRIP-[A-Z0-9]{8}$"
          }
        },
        "outcome": {
          "schema": {
            "type": "string",
            "enum": [
              "auto-replanned",
              "options-proposed",
              "approval-required",
              "no-action"
            ]
          }
        }
      },
      "publish": {
        "operationId": "consumeItineraryReplanned",
        "summary": "Replanning decision emitted by Solace Agent Mesh.",
        "message": {
          "$ref": "#/components/messages/ItineraryReplanned"
        }
      }
    }
  },
  "components": {
    "messages": {
      "FlightStatusChanged": {
        "name": "FlightStatusChanged",
        "title": "Flight Status Changed",
        "summary": "An airline operational irregularity affecting a scheduled flight.",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/FlightStatusChanged"
        }
      },
      "WeatherAlertIssued": {
        "name": "WeatherAlertIssued",
        "title": "Weather Alert Issued",
        "summary": "A meteorological alert issued for a destination.",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/WeatherAlertIssued"
        }
      },
      "HotelBookingImpacted": {
        "name": "HotelBookingImpacted",
        "title": "Hotel Booking Impacted",
        "summary": "A property-side event affecting a hotel stay.",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/HotelBookingImpacted"
        }
      },
      "GroundAdvisoryPublished": {
        "name": "GroundAdvisoryPublished",
        "title": "Ground Advisory Published",
        "summary": "A destination-side advisory affecting local movement or activities.",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/GroundAdvisoryPublished"
        }
      },
      "ItineraryReplanned": {
        "name": "ItineraryReplanned",
        "title": "Itinerary Replanned",
        "summary": "Replanning decision emitted by Solace Agent Mesh.",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/ItineraryReplanned"
        }
      }
    },
    "schemas": {
      "FlightStatusChanged": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "eventType",
          "specVersion",
          "occurredAt",
          "source",
          "severity",
          "flight",
          "disruption"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for this event instance."
          },
          "eventType": {
            "type": "string",
            "enum": [
              "travel.flight.statusChanged"
            ]
          },
          "specVersion": {
            "type": "string",
            "enum": [
              "1.0"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the operational change was recorded. Generate as recent past."
          },
          "source": {
            "type": "string",
            "enum": [
              "ops.airline.ocs",
              "ops.airport.aodb"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "minor",
              "major",
              "critical"
            ]
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "flight": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "corridor",
              "scheduledDepartureUtc"
            ],
            "properties": {
              "corridor": {
                "type": "string",
                "description": "Identical enum to the {corridorKey} topic parameter. In `stm feed configure`, MAP the {corridorKey} topic parameter to this payload field so the two are guaranteed identical. If your STM version does not support topic parameter mapping, delete this field and have TripGuardianAgent read the corridor from the topic string instead — the topic is authoritative.\n",
                "enum": [
                  "SG-SIN-HND",
                  "SG-SIN-NRT",
                  "IN-BLR-SFO",
                  "KE-NBO-EZE",
                  "GB-LHR-DPS"
                ]
              },
              "flightNumber": {
                "type": "string",
                "description": "COSMETIC ONLY — makes the event read like a real ops feed. Generated from a pattern, so it will NOT exist in flight_offers.flight_no. Never look it up. FlightSearchAgent finds alternatives by querying the corridor's route.\n",
                "pattern": "^(SQ|BA|AI|KQ|UA|JL|NH|GA)[0-9]{2,4}$"
              },
              "scheduledDepartureUtc": {
                "type": "string",
                "format": "date-time",
                "description": "Originally scheduled departure. Generate as near future (0-14 days)."
              },
              "terminalDep": {
                "type": "string",
                "enum": [
                  "1",
                  "2",
                  "3",
                  "4",
                  "A",
                  "B"
                ]
              },
              "gate": {
                "type": "string",
                "pattern": "^[A-F](0[1-9]|[1-4][0-9])$"
              }
            }
          },
          "disruption": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "reason"
            ],
            "properties": {
              "type": {
                "type": "string",
                "description": "Identical enum to the {disruptionType} topic parameter, same casing, so the two can be bound by topic parameter mapping.\n",
                "enum": [
                  "delay",
                  "cancellation",
                  "gate-change",
                  "diversion",
                  "equipment-change",
                  "schedule-change"
                ]
              },
              "delayMinutes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 720,
                "description": "Minutes of delay. Zero for CANCELLATION and GATE_CHANGE. Deliberately no newDepartureUtc field — the agent derives it from scheduledDepartureUtc + delayMinutes, so the two can never contradict each other.\n"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "WEATHER",
                  "TECHNICAL",
                  "ATC",
                  "CREW",
                  "SECURITY",
                  "STRIKE",
                  "AIRPORT_OPS"
                ]
              },
              "rebookingAvailable": {
                "type": "boolean"
              },
              "bookingRef": {
                "type": "string",
                "pattern": "^[A-Z0-9]{6}$",
                "description": "PNR of an affected booking. Correlates to a watched trip."
              }
            }
          },
          "impact": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "passengersAffected": {
                "type": "integer",
                "minimum": 1,
                "maximum": 420
              },
              "connectionRisk": {
                "type": "string",
                "enum": [
                  "NONE",
                  "LOW",
                  "HIGH"
                ]
              }
            }
          }
        }
      },
      "WeatherAlertIssued": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "eventType",
          "specVersion",
          "occurredAt",
          "source",
          "severity",
          "location",
          "alert"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "eventType": {
            "type": "string",
            "enum": [
              "travel.weather.alertIssued"
            ]
          },
          "specVersion": {
            "type": "string",
            "enum": [
              "1.0"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "enum": [
              "weather.national-service",
              "weather.aggregator.open-meteo"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "minor",
              "major",
              "critical"
            ]
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "locationKey"
            ],
            "properties": {
              "locationKey": {
                "type": "string",
                "description": "Identical enum to the {locationKey} topic parameter. Bind the two with a topic parameter mapping in `stm feed configure`. The city half MUST match hotel_offers.city_code (Q2).\n",
                "enum": [
                  "JP-TYO",
                  "TH-HKT",
                  "ID-DPS",
                  "AR-BUE"
                ]
              }
            }
          },
          "alert": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "headline",
              "onsetUtc",
              "durationHours"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "typhoon",
                  "heavy-rain",
                  "snow",
                  "heatwave",
                  "wind",
                  "thunderstorm",
                  "flood"
                ]
              },
              "headline": {
                "type": "string",
                "description": "Curated pool. Never generate free text with Faker lorem.",
                "enum": [
                  "Severe weather warning in effect for the metropolitan area",
                  "Heavy precipitation expected, localised flooding possible",
                  "High winds forecast, outdoor attractions may close",
                  "Extreme heat advisory issued for daytime hours",
                  "Thunderstorms expected, ground stops possible at area airports",
                  "Winter weather advisory, surface transport delays likely"
                ]
              },
              "onsetUtc": {
                "type": "string",
                "format": "date-time",
                "description": "When the alert takes effect. Generate as near future (0-5 days)."
              },
              "durationHours": {
                "type": "integer",
                "minimum": 3,
                "maximum": 96,
                "description": "Duration instead of an end timestamp. Guarantees the window is always valid regardless of what the generator picks.\n"
              },
              "confidence": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 1
              }
            }
          },
          "guidance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "outdoorActivitiesAdvised": {
                "type": "boolean"
              },
              "transportImpactLikely": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "HotelBookingImpacted": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "eventType",
          "specVersion",
          "occurredAt",
          "source",
          "severity",
          "hotel",
          "impact"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "eventType": {
            "type": "string",
            "enum": [
              "travel.hotel.bookingImpacted"
            ]
          },
          "specVersion": {
            "type": "string",
            "enum": [
              "1.0"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "enum": [
              "hotel.pms",
              "hotel.channel-manager"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "minor",
              "major",
              "critical"
            ]
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "hotel": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "locationKey",
              "starRating"
            ],
            "properties": {
              "starRating": {
                "type": "string",
                "description": "Star band of the affected properties. No hotel NAME in this event on purpose — a generated name would drift from the city and would need extracting from the database. Instead HotelSearchAgent queries hotel_offers by city_code + star_rating to find the affected and alternative properties itself.\n",
                "enum": [
                  "3",
                  "4",
                  "5"
                ]
              },
              "locationKey": {
                "type": "string",
                "enum": [
                  "JP-TYO",
                  "TH-HKT",
                  "ID-DPS",
                  "AR-BUE"
                ]
              }
            }
          },
          "impact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "affectedFromDate",
              "affectedNights"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "overbooking",
                  "maintenance-closure",
                  "rate-change",
                  "amenity-unavailable",
                  "evacuation"
                ]
              },
              "affectedFromDate": {
                "type": "string",
                "format": "date",
                "description": "First affected night. Generate as near future (0-30 days)."
              },
              "affectedNights": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7,
                "description": "Nights affected, instead of an end date."
              },
              "affectedRoomTypes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "description": "MUST match hotel_offers.room_type values exactly.",
                  "enum": [
                    "STANDARD_ROOM",
                    "DELUXE_ROOM",
                    "SUITE",
                    "BEACH_VILLA"
                  ]
                }
              },
              "affectedAmenities": {
                "type": "array",
                "minItems": 0,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "description": "MUST match values found in hotel_offers.amenities.",
                  "enum": [
                    "POOL",
                    "SPA",
                    "WIFI",
                    "RESTAURANT",
                    "GYM",
                    "PARKING"
                  ]
                }
              },
              "alternativeOffered": {
                "type": "boolean"
              },
              "newRatePerNightUsd": {
                "type": "number",
                "minimum": 60,
                "maximum": 1200,
                "description": "Populated only for RATE_CHANGE. Range mirrors hotel_offers.price_per_night."
              },
              "bookingRef": {
                "type": "string",
                "pattern": "^[A-Z0-9]{6}$"
              }
            }
          }
        }
      },
      "GroundAdvisoryPublished": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "eventType",
          "specVersion",
          "occurredAt",
          "source",
          "severity",
          "location",
          "advisory"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "eventType": {
            "type": "string",
            "enum": [
              "travel.ground.advisoryPublished"
            ]
          },
          "specVersion": {
            "type": "string",
            "enum": [
              "1.0"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "enum": [
              "city.transport-authority",
              "city.tourism-board",
              "gov.travel-advisory"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "minor",
              "major",
              "critical"
            ]
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "locationKey"
            ],
            "properties": {
              "locationKey": {
                "type": "string",
                "enum": [
                  "JP-TYO",
                  "TH-HKT",
                  "ID-DPS",
                  "AR-BUE"
                ]
              }
            }
          },
          "advisory": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "headline",
              "startUtc",
              "durationHours"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "transit-strike",
                  "road-closure",
                  "attraction-closure",
                  "public-event",
                  "security-alert",
                  "health-notice"
                ]
              },
              "headline": {
                "type": "string",
                "enum": [
                  "Metro and bus services reduced to a limited timetable",
                  "Central district roads closed for a scheduled public event",
                  "Major museum closed for unscheduled maintenance",
                  "Large public gathering expected, heavy congestion likely",
                  "Increased security screening at major transport hubs",
                  "Rail services suspended between the airport and city centre"
                ]
              },
              "startUtc": {
                "type": "string",
                "format": "date-time",
                "description": "Generate as near future (0-14 days)."
              },
              "durationHours": {
                "type": "integer",
                "minimum": 2,
                "maximum": 120
              },
              "affectedModes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "enum": [
                    "METRO",
                    "BUS",
                    "RAIL",
                    "TAXI",
                    "FERRY",
                    "ROAD"
                  ]
                }
              }
            }
          }
        }
      },
      "ItineraryReplanned": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "eventType",
          "specVersion",
          "occurredAt",
          "source",
          "severity",
          "trip",
          "trigger",
          "outcome"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "eventType": {
            "type": "string",
            "enum": [
              "travel.itinerary.replanned"
            ]
          },
          "specVersion": {
            "type": "string",
            "enum": [
              "1.0"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "enum": [
              "agent.sam.trip-guardian"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "minor",
              "major",
              "critical"
            ]
          },
          "correlationId": {
            "type": "string",
            "format": "uuid",
            "description": "Carries the eventId of the disruption event that triggered this."
          },
          "trip": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tripId",
              "corridor"
            ],
            "properties": {
              "tripId": {
                "type": "string",
                "pattern": "^TRIP-[A-Z0-9]{8}$"
              },
              "travelerId": {
                "type": "string",
                "pattern": "^TRV-[0-9]{6}$"
              },
              "corridor": {
                "type": "string",
                "enum": [
                  "SG-SIN-HND",
                  "SG-SIN-NRT",
                  "IN-BLR-SFO",
                  "KE-NBO-EZE",
                  "GB-LHR-DPS"
                ]
              },
              "startDate": {
                "type": "string",
                "format": "date"
              },
              "nights": {
                "type": "integer",
                "minimum": 1,
                "maximum": 21
              }
            }
          },
          "trigger": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "eventId",
              "eventType"
            ],
            "properties": {
              "eventId": {
                "type": "string",
                "format": "uuid"
              },
              "eventType": {
                "type": "string",
                "enum": [
                  "travel.flight.statusChanged",
                  "travel.weather.alertIssued",
                  "travel.hotel.bookingImpacted",
                  "travel.ground.advisoryPublished"
                ]
              },
              "topic": {
                "type": "string"
              }
            }
          },
          "outcome": {
            "type": "string",
            "enum": [
              "AUTO_REPLANNED",
              "OPTIONS_PROPOSED",
              "APPROVAL_REQUIRED",
              "NO_ACTION"
            ]
          },
          "changes": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "domain",
                "before",
                "after"
              ],
              "properties": {
                "domain": {
                  "type": "string",
                  "enum": [
                    "FLIGHT",
                    "HOTEL",
                    "ACTIVITY",
                    "PACKING"
                  ]
                },
                "before": {
                  "type": "string"
                },
                "after": {
                  "type": "string"
                },
                "deltaUsd": {
                  "type": "number"
                }
              }
            }
          },
          "budget": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "originalUsd": {
                "type": "number",
                "minimum": 0
              },
              "revisedUsd": {
                "type": "number",
                "minimum": 0
              },
              "deltaUsd": {
                "type": "number"
              }
            }
          },
          "humanApproval": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "required": {
                "type": "boolean"
              },
              "requestedAt": {
                "type": "string",
                "format": "date-time"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "Rebooking cost exceeds the approved budget delta",
                  "Cancellation requires a change of destination city",
                  "No alternative accommodation available within policy",
                  "Change affects more than one traveller on the booking"
                ]
              }
            }
          }
        }
      }
    }
  }
}